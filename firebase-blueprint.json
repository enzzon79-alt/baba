{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Artigo do catálogo oficial BABA SHOPPING",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "officialPrice": { "type": "number" },
        "suggestedResalePrice": { "type": "number" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array" }
      },
      "required": ["id", "name", "category", "officialPrice", "imageUrl"]
    },
    "User": {
      "title": "User",
      "description": "Utilizador da plataforma BABA SHOPPING e estado da validação de Bilhete (KYC)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin"] },
        "accountStatus": { "type": "string", "enum": ["ativo", "em_processamento", "rejeitado", "suspenso"] },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "idNumber": { "type": "string" },
        "birthDate": { "type": "string" },
        "idCardFront": { "type": "string" },
        "idCardBack": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "suspensionReason": { "type": "string" },
        "referralRewardPaid": { "type": "boolean" },
        "verifiedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "accountStatus"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Carteira digital de saldo e histórico de movimentos",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "availableBalance": { "type": "number" },
        "pendingBalance": { "type": "number" },
        "reservedBalance": { "type": "number" },
        "totalDeposited": { "type": "number" },
        "totalSpent": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "availableBalance"]
    },
    "ResaleListing": {
      "title": "ResaleListing",
      "description": "Anúncio no Mercado de Revenda P2P",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userProductId": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "productName": { "type": "string" },
        "category": { "type": "string" },
        "originalPrice": { "type": "number" },
        "listingPrice": { "type": "number" },
        "minAcceptablePrice": { "type": "number" },
        "customDescription": { "type": "string" },
        "allowNegotiation": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pendente", "ativo", "vendido", "pausado", "rejeitado"] },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "sellerId", "listingPrice", "status"]
    },
    "UserProduct": {
      "title": "UserProduct",
      "description": "Produto na secção Meus Produtos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "currentOwnerId": { "type": "string" },
        "originalProductId": { "type": "string" },
        "productName": { "type": "string" },
        "category": { "type": "string" },
        "originalPrice": { "type": "number" },
        "productImage": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "status": { "type": "string", "enum": ["disponivel", "anunciado", "vendido"] }
      },
      "required": ["id", "currentOwnerId", "originalProductId", "status"]
    },
    "Negotiation": {
      "title": "Negotiation",
      "description": "Proposta de negociação P2P",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "productName": { "type": "string" },
        "listedPrice": { "type": "number" },
        "currentProposedPrice": { "type": "number" },
        "lastOfferBy": { "type": "string", "enum": ["buyer", "seller"] },
        "status": { "type": "string", "enum": ["aguardando_adm", "pendente", "contraproposta", "aceite", "recusada", "concluida", "cancelada"] },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "listingId", "buyerId", "sellerId", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notificação em tempo real",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "linkType": { "type": "string" },
        "linkId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientId", "title", "message", "read"]
    },
    "Deposit": {
      "title": "Deposit",
      "description": "Pedido de carregamento de carteira",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "reference": { "type": "string" },
        "receiptProof": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "aprovado", "rejeitado"] },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "amount", "paymentMethod", "reference", "status", "createdAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Pedido de levantamento de saldo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "bankName": { "type": "string" },
        "iban": { "type": "string" },
        "accountHolder": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "processado", "rejeitado", "recusado"] },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "amount", "bankName", "iban", "accountHolder", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Pedido de compra na plataforma",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentReference": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "buyerId", "totalAmount", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Registo de transação financeira",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "reference": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "status", "createdAt"]
    },
    "AssistantConversation": {
      "title": "AssistantConversation",
      "description": "Conversa de atendimento com Assistente Jeniffer e Administrador",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["ativo", "aguardando_adm", "resolvido"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catálogo de produtos oficiais da BABA SHOPPING"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Contas de utilizadores e estado KYC"
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Carteiras digitais dos utilizadores"
    },
    "/resale_listings/{listingId}": {
      "schema": { "$ref": "#/entities/ResaleListing" },
      "description": "Mercado P2P de revenda de produtos"
    },
    "/user_products/{id}": {
      "schema": { "$ref": "#/entities/UserProduct" },
      "description": "Produtos no inventário de cada utilizador"
    },
    "/negotiations/{negotiationId}": {
      "schema": { "$ref": "#/entities/Negotiation" },
      "description": "Propostas e contrapropostas de preço"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Notificações enviadas aos utilizadores"
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/Deposit" },
      "description": "Pedidos de carregamento com talão Multicaixa"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Pedidos de levantamento para conta bancária"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Pedidos de compra registados"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Histórico de movimentos financeiros"
    },
    "/assistant_conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/AssistantConversation" },
      "description": "Atendimento inteligente Assistente Jeniffer"
    }
  }
}
