rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'oYHKf9Uvp5Sm0aPyUefjM8aNrrK2' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isPositiveNumber(val) {
      return val is number && val > 0;
    }

    // ===============================================================
    // Collections
    // ===============================================================

    // Verificação de ligação pública ao Firestore
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resolução segura de email para login por telemóvel/BI sem expor lista de utilizadores
    match /login_hints/{hintKey} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Códigos de convite para validação no registo
    match /referral_codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Registo de convites / indicações
    match /referrals/{invitedUserId} {
      allow get, list: if isAdmin() || (
        isSignedIn() &&
        (resource.data.referrerId == request.auth.uid || resource.data.invitedUserId == request.auth.uid)
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.invitedUserId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Catálogo oficial (leitura pública, atualização de stock permitida em compra autenticada)
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'status']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= resource.data.stock
      );
    }

    // Contas de utilizadores e validação de Bilhete de Identidade (KYC)
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == userId &&
        isValidString(request.resource.data.name, 2, 120) &&
        isValidString(request.resource.data.email, 3, 160) &&
        request.resource.data.role == 'client' &&
        request.resource.data.accountStatus == 'em_processamento'
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accountStatus != 'ativo' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'idCardFront',
          'idCardBack',
          'idNumber',
          'accountStatus',
          'rejectionReason',
          'province',
          'city',
          'phone',
          'name',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin() && userId != 'oYHKf9Uvp5Sm0aPyUefjM8aNrrK2';
    }

    // Carteiras digitais (proprietário, administrador ou crédito ao vendedor em compra P2P)
    match /wallets/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.userId == userId
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.userId == userId
      ) || (
        isSignedIn() &&
        request.resource.data.userId == userId &&
        request.resource.data.availableBalance is number &&
        request.resource.data.availableBalance >= resource.data.availableBalance &&
        request.resource.data.totalEarned is number &&
        request.resource.data.totalEarned >= resource.data.totalEarned &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availableBalance',
          'totalEarned',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Pedidos de depósito (apenas o Administrador pode aprovar ou rejeitar)
    match /deposits/{depositId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.userName, 1, 120) &&
        isPositiveNumber(request.resource.data.amount) &&
        request.resource.data.status == 'pendente' &&
        request.resource.data.keys().hasAll(['id', 'userId', 'userName', 'amount', 'reference', 'status', 'createdAt']) &&
        (request.resource.data.paymentMethod is string || request.resource.data.method is string)
      );
      allow update, delete: if isAdmin();
    }

    // Pedidos de levantamento / saque (apenas o Administrador pode processar ou rejeitar)
    match /withdrawals/{withdrawalId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.userName, 1, 120) &&
        isPositiveNumber(request.resource.data.amount) &&
        isValidString(request.resource.data.iban, 5, 64) &&
        request.resource.data.status == 'pendente' &&
        request.resource.data.keys().hasAll(['id', 'userId', 'userName', 'amount', 'bankName', 'iban', 'accountHolder', 'status', 'createdAt'])
      );
      allow update, delete: if isAdmin();
    }

    // Transações financeiras
    match /transactions/{transactionId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() &&
        (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.type in ['venda_recebida', 'taxa_plataforma']
        )
      );
      allow update, delete: if isAdmin();
    }

    // Pedidos de compra
    match /orders/{orderId} {
      allow get, list: if isAdmin() || (
        isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
      );
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.buyerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Mercado P2P de revenda
    match /resale_listings/{listingId} {
      allow get, list: if resource.data.status == 'ativo' || isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId
      ) || (
        isSignedIn() &&
        resource.data.status == 'ativo' &&
        request.resource.data.status == 'vendido' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // Inventário de produtos dos utilizadores
    match /user_products/{id} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.currentOwnerId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.currentOwnerId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.currentOwnerId == request.auth.uid
      ) || (
        isSignedIn() &&
        resource.data.status != 'vendido' &&
        request.resource.data.status == 'vendido' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    // Negociações P2P
    match /negotiations/{negotiationId} {
      allow get, list: if isAdmin() || (
        isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
      );
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.buyerId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
      ) || (
        isSignedIn() &&
        request.resource.data.status == 'cancelada' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusMessage', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Notificações
    match /notifications/{notificationId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() &&
        (
          request.resource.data.recipientId == request.auth.uid ||
          request.resource.data.recipientId == 'oYHKf9Uvp5Sm0aPyUefjM8aNrrK2' ||
          request.resource.data.type in ['venda', 'compra', 'negociacao']
        )
      );
      allow update: if isAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Conversas com Assistente Jeniffer / Suporte ADM
    match /assistant_conversations/{conversationId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Registo administrativo de contas removidas
    match /deleted_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
